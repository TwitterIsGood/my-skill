# Copy this file to the project where you invoke the skills, not into the skill bundle.
UI_REPLICA_BASE_URL=https://your-openai-compatible-relay.example/v1
UI_REPLICA_API_KEY=replace-with-a-local-secret
UI_REPLICA_IMAGE_MODEL=gpt-image-2
UI_REPLICA_UI_MODEL=gpt-5.6-sol
UI_REPLICA_REASONING_EFFORT=xhigh

# Optional network/runtime controls.
# UI_REPLICA_PROXY=http://127.0.0.1:7890
UI_REPLICA_TIMEOUT=600
UI_REPLICA_MAX_RETRIES=1
# UI_REPLICA_CHROME=/absolute/path/to/Google Chrome
